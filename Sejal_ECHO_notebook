      "source": [
        "def train_classifier(classifier, dataloader, projector=None, epochs=20):\n",
        "    optimizer = optim.Adam(classifier.parameters(), lr=1e-3)\n",
        "    criterion = nn.CrossEntropyLoss()\n",
        "\n",
        "\n",
        "    if projector: projector.eval()  # freezinf projection block\n",
        "    classifier.train()\n",
        "    print(\"Classification phase\")\n",
        "    for epoch in range(epochs):\n",
        "        epoch_loss = 0\n",
        "        for vggish_feats, _, labels in dataloader:\n",
        "            vggish_feats, labels = vggish_feats.to(device), labels.to(device)\n",
        "            optimizer.zero_grad()\n",
        "            if projector:\n",
        "                with torch.no_grad():\n",
        "                    features = projector(vggish_feats)\n",
        "            else:\n",
        "                features = vggish_feats\n",
        "\n",
        "            logits = classifier(features)\n",
        "            loss = criterion(logits, labels)\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "            epoch_loss += loss.item()\n",
        "\n",
        "        print(f\"Epoch {epoch+1}/{epochs} CE Loss: {epoch_loss/len(dataloader):.4f}\")"
