      "source": [
        "def evaluate_model(classifier, dataloader, projector=None):\n",
        "    classifier.eval()\n",
        "    if projector: projector.eval()\n",
        "\n",
        "    all_preds, all_labels = [], []\n",
        "    with torch.no_grad():\n",
        "        for vggish_feats, _, labels in dataloader:\n",
        "            vggish_feats = vggish_feats.to(device)\n",
        "\n",
        "            features = projector(vggish_feats) if projector else vggish_feats\n",
        "            logits = classifier(features)\n",
        "            preds = torch.argmax(logits, dim=1)\n",
        "\n",
        "            all_preds.extend(preds.cpu().numpy())\n",
        "            all_labels.extend(labels.numpy())\n",
        "\n",
        "    acc = accuracy_score(all_labels, all_preds)\n",
        "    mac_f1 = f1_score(all_labels, all_preds, average='macro', zero_division=0)\n",
        "    wgt_f1 = f1_score(all_labels, all_preds, average='weighted', zero_division=0)\n",
        "    cm = confusion_matrix(all_labels, all_preds)\n",
        "\n",
        "    print(f\"Accuracy:    {acc:.4f}\")\n",
        "    print(f\"Macro-F1:    {mac_f1:.4f}\")\n",
        "    print(f\"Weighted-F1: {wgt_f1:.4f}\")\n",
        "    print(\"Confusion Matrix:\")\n",
        "    print(cm)\n",
        "\n",
        "    return acc"
      ]
