        "class VGGishFeatureExtractor(BaseEstimator, TransformerMixin):\n",
        "    def extract_vggish_embeddings(self, file_path):\n",
        "        sample, _ = librosa.load(file_path, sr=TARGET_SAMPLE_RATE)\n",
        "\n",
        "        if len(sample) < MAX_AUDIO_SAMPLES:\n",
        "            sample = np.pad(sample, (0, MAX_AUDIO_SAMPLES - len(sample)))#Padding\n",
        "        else:\n",
        "            sample = sample[:MAX_AUDIO_SAMPLES]\n",
        "\n",
        "        if np.max(np.abs(sample)) > 0:#Normali\n",
        "            sample = sample / np.max(np.abs(sample))\n",
        "\n",
        "        sample_tf = tf.constant(sample, dtype=tf.float32)\n",
        "        embeddings = vggish_model(sample_tf)\n",
        "\n",
        "\n",
        "        return embeddings.numpy()"
      ]
    },
