        "class BrainProjector(nn.Module):\n",
        "\n",
        "    def __init__(self, input_dim=128, output_dim=200):\n",
        "        super(BrainProjector, self).__init__()\n",
        "        self.network = nn.Sequential(\n",
        "            nn.Linear(input_dim, 128),\n",
        "            nn.BatchNorm1d(128),\n",
        "            nn.ReLU(),\n",
        "            nn.Dropout(0.6),\n",
        "            nn.Linear(128, output_dim)\n",
        "        )     #maps 128D to 200D brain one\n",
        "\n",
        "    def forward(self, x):\n",
        "        return self.network(x)"
      ]
