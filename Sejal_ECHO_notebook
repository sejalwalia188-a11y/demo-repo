        "def train_alignment(projector, dataloader, epochs=20):\n",
        "    optimizer = optim.Adam(projector.parameters(), lr=1e-3,weight_decay=1e-4  )\n",
        "    criterion = nn.MSELoss()\n",
        "    projector.train()\n",
        "    print(\"Alignment phase\")\n",
        "    for epoch in range(epochs):\n",
        "        epoch_loss = 0\n",
        "        for vggish_feats, true_eeg, _ in dataloader:\n",
        "            vggish_feats, true_eeg = vggish_feats.to(device), true_eeg.to(device)\n",
        "\n",
        "            optimizer.zero_grad()\n",
        "            projected = projector(vggish_feats)\n",
