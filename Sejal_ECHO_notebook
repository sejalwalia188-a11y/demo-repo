      "source": [
        "def extract_and_save_refined_embeddings(projector, dataloader, save_path):\n",
        "    projector.eval()\n",
        "    all_refined_embeddings = []\n",
        "    all_labels = []\n",
        "\n",
        "    print(f\"\\nsaving refined embeddings to: {save_path}\")\n",
        "\n",
        "    with torch.no_grad():\n",
        "        for vggish_feats, _, labels in dataloader:\n",
        "            vggish_feats = vggish_feats.to(device)\n",
        "            refined_feats = projector(vggish_feats)\n",
        "\n",
        "            all_refined_embeddings.append(refined_feats.cpu().numpy())\n",
        "            all_labels.append(labels.numpy())\n",
        "\n",
        "    final_embeddings = np.vstack(all_refined_embeddings)\n",
        "    final_labels = np.concatenate(all_labels)\n",
        "\n",
        "    np.savez(save_path, embeddings=final_embeddings, labels=final_labels)\n",
        "    print(f\"Saved {final_embeddings.shape[0]} embeddings of shape {final_embeddings.shape[1]}-D.\")"
      ]
