        "class EmotionEEGDataset(Dataset):\n",
        "    def __init__(self, csv_filepath, audio_dir, eeg_dir, extractor):\n",
        "        self.data_frame = pd.read_csv(csv_filepath)\n",
        "        self.audio_dir = audio_dir\n",
        "        self.eeg_dir = eeg_dir\n",
        "        self.extractor = extractor\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.data_frame)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        row = self.data_frame.iloc[idx]\n",
        "\n",
        "\n",
        "        audio_rel_path = row['audio_wav_filepath'].replace(\"audio/\", \"\", 1) if row['audio_wav_filepath'].startswith(\"audio/\") else row['audio_wav_filepath']\n",
        "        audio_path = os.path.join(self.audio_dir, audio_rel_path)  #audio loading\n",
        "\n",
        "        vggish_frames = self.extractor.extract_vggish_embeddings(audio_path)\n",
        "        vggish_tensor = torch.tensor(vggish_frames).float().mean(dim=0)\n",
        "\n",
        "\n",
        "        embed_rel_path = row['brain_embedding_filepath'].replace(\"embeddings/\", \"\", 1) if row['brain_embedding_filepath'].startswith(\"embeddings/\") else row['brain_embedding_filepath']\n",
        "        embed_path = os.path.join(self.eeg_dir, embed_rel_path)\n",
        "        eeg_tensor = torch.from_numpy(np.load(embed_path)).float()   #embeddings loading\n",
        "\n",
        "\n",
        "        emotion_ans= row['emotion'].strip().lower()   #label loading\n",
        "        label_tensor = torch.tensor(LABLE_MAPPING[emotion_ans], dtype=torch.long)\n",
        "\n",
        "        return vggish_tensor, eeg_tensor, label_tensor"
      ]
    },
